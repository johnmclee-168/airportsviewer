# Production defaults (loaded by `next build` and `next start`, i.e. `npm run build` / `npm start`).
#
# Pins the airport data source to the live Qantas API so a production build never
# serves mock, delayed or simulated-failure data, even if a stray `.env` file sets
# these for local work. No secrets here: this file is committed.
#
# Precedence (Next.js): variables set in the shell and `.env.production.local`
# still override this file. That is deliberate, so the offline e2e check can run
# `AIRPORTS_SOURCE=mock npm start` against a production build.

# live = fetch https://api.qantas.com/flight/refData/airport (mock = local snapshot)
AIRPORTS_SOURCE=live

# Empty = use the real Qantas endpoint (not the Express mock server)
AIRPORTS_UPSTREAM_URL=

# No artificial latency
AIRPORTS_MOCK_DELAY_MS=0

# Never simulate API failures
AIRPORTS_SIMULATE_FAILURE=0
